# Copy to .env.local and fill in. Never commit .env.local.
# Everything here has a free tier or is free.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (older projects call it the anon key; either name works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (older projects: service_role). SERVER ONLY. Bypasses row level security.
SUPABASE_SECRET_KEY=

# --- Cron (Supabase pg_cron calls /api/engine/tick with this secret) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Weekly summary push sender (POST /api/engine/notify, called by pg_cron; see SETUP-CHECKLIST.md 6ד) ---
# Sending is OFF unless this is exactly 1. Empty, true, yes, 0: the route stays a DRY RUN that reads and counts and sends nothing.
# A request with ?dryRun=1 is always a dry run, whatever this says.
NOTIFY_SENDER_LIVE=
# Local rehearsals only (npm run dev against the local Supabase): fake sends nothing and records it. Never accepted in production.
# PUSH_FAKE_BEHAVIOR scripts the fake's answer: ok (default), gone, rejected, retryable or throw.
PUSH_PROVIDER=
PUSH_FAKE_BEHAVIOR=

# --- AI providers (server only; with no key the app uses the manual path: the text is kept as a list) ---
# Google AI Studio key (free tier). Leave empty to turn Gemini off.
GEMINI_API_KEY=
# Model id. Empty = the default in src/lib/ai/config.ts (placeholder until the Hebrew bake-off picks one).
GEMINI_MODEL=
# Groq console key (free tier). Leave empty to turn Groq off.
GROQ_API_KEY=
# Model id. Empty = the default in src/lib/ai/config.ts.
GROQ_MODEL=
# json_object (default; works with photos) or json_schema (strict). Empty = default.
GROQ_RESPONSE_FORMAT=
# Order the providers are tried in, comma separated: gemini,groq (default). "none" = no AI at all (tests the manual path).
# In development with no key the visible fake provider is used. The fake is never used in production.
AI_PROVIDER_ORDER=
# Provider attempts allowed per user per day (default 40) and per minute (default 3). 0 blocks everything.
AI_DAILY_CAP=
AI_PER_MINUTE_CAP=
