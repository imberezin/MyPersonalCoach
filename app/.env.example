# Copy to .env.local and fill in. Never commit .env.local.
# Everything here has a free tier or is free.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (older projects call it the anon key; either name works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (older projects: service_role). SERVER ONLY. Bypasses row level security.
SUPABASE_SECRET_KEY=

# --- Cron (Supabase pg_cron calls /api/engine/tick with this secret) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI providers (adapters are added after the Hebrew bake-off) ---
GEMINI_API_KEY=
GROQ_API_KEY=
